# Copiar este archivo a .env y agregar la clave; .env no se sube al repositorio.
GOOGLE_MAPS_API_KEY=
# Mostrar el mapa de Google dentro de la cotización solo si es true.
ENABLE_MAP=false
# Mostrar el texto del mensaje y el botón para copiarlo solo si es true.
ENABLE_MESSAGE=false
# true: Turnstile obligatorio; false: búsquedas y cotizaciones sin CAPTCHA.
CHEK_IS_HUMAN=true
# Claves pública y privada de Cloudflare Turnstile.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
BASE_PLACE_ID=
GOOGLE_MONTHLY_LIMIT=9000
PORT=5173
WHATSAPP_NUMBER=59899553986
FUEL_CITY_KM_PER_LITER=11
FUEL_ROAD_KM_PER_LITER=15
FUEL_PRICE_UYU_PER_LITER=95
LABOR_UYU_PER_HOUR=400
MONTEVIDEO_MARKUP_PERCENT=30
MINIMUM_SALE_UYU=600
